{
  "name": "nexusone-backend",
  "version": "1.0.0",
  "private": true,
  "description": "NexusOne microservices backend (NestJS) — gateway, auth, org, chat, projects, files, calendar, notifications, ai",
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:all": "npm run build --workspaces --if-present",
    "start:gateway": "node services/gateway/dist/main.js",
    "start:auth": "node services/auth/dist/main.js",
    "start:org": "node services/org/dist/main.js",
    "start:chat": "node services/chat/dist/main.js",
    "start:projects": "node services/projects/dist/main.js",
    "start:files": "node services/files/dist/main.js",
    "start:calendar": "node services/calendar/dist/main.js",
    "start:notifications": "node services/notifications/dist/main.js",
    "start:ai": "node services/ai/dist/main.js",
    "dev:all": "concurrently -n gateway,auth,org,chat,projects,files,calendar,notif,ai -c blue,green,magenta,cyan,yellow,red,white,gray,black \"npm run start:dev -w @nexusone/gateway\" \"npm run start:dev -w @nexusone/auth\" \"npm run start:dev -w @nexusone/org\" \"npm run start:dev -w @nexusone/chat\" \"npm run start:dev -w @nexusone/projects\" \"npm run start:dev -w @nexusone/files\" \"npm run start:dev -w @nexusone/calendar\" \"npm run start:dev -w @nexusone/notifications\" \"npm run start:dev -w @nexusone/ai\"",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@nestjs/apollo": "^12.2.0",
    "@nestjs/axios": "^3.0.2",
    "axios": "^1.7.4",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/graphql": "^12.2.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.10",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/platform-socket.io": "^10.4.4",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.4.4",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "graphql": "^16.9.0",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^3.0.3",
    "ioredis": "^5.4.1",
    "mongoose": "^8.6.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.60.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.15",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
